<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>15</LangVersion>
	</PropertyGroup>

	<!-- Release binaries from Astro.Packaging: one self-contained executable, so users don't need .NET installed. -->
	<PropertyGroup Condition="'$(AstroRelease)' == 'true'">
		<AssemblyName>astro</AssemblyName>
		<SelfContained>true</SelfContained>
		<PublishSingleFile>true</PublishSingleFile>
		<!-- SQLite's native library has to be extracted to load; this bundles it into the single file. -->
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
		<EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
		<!-- Commands, behaviors, IoC and EF Core all rely on reflection, which trimming would break. -->
		<PublishTrimmed>false</PublishTrimmed>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Discord.Net" Version="3.20.2" />
		<PackageReference Include="Discord.Net.Analyzers" Version="3.14.1" />
		<PackageReference Include="Neomoth.IoC" Version="1.0.1" />
		<PackageReference Include="Neomoth.RTLogging" Version="1.0.1" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Remove="Resources\**" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Remove="Resources\**" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="Resources\**" />
		<None Remove=".gitignore" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\Resources\**" LinkBase="Resources" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Astro.Abstractions\Astro.Abstractions.csproj" />
		<ProjectReference Include="..\Astro.DB\Astro.DB.csproj" />
	</ItemGroup>
	
	<ItemGroup>
		<ProjectReference Include="..\Astro.CodeFixes\Astro.CodeFixes.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
		<ProjectReference Include="..\Astro.Roslyn\Astro.Roslyn.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

</Project>
