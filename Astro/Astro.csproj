	</PropertyGroup>

	<ItemGroup>
	  <PackageReference Include="Discord.Net" Version="3.18.0" />
	  <PackageReference Include="Discord.Net.Analyzers" Version="3.14.1" />
	  <PackageReference Include="Serilog" Version="4.3.0" />
